# Copy this file to .env for local development. Environment variables take priority.
APP_NAME="Private E-Learning Platform"
APP_DESCRIPTION="Private e-learning platform backend API."
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true
# Browser origins allowed to call this API, comma separated. Exact
# scheme://host[:port] entries only: no path, no trailing slash, no wildcard.
# This development default serves the Vite dev server; production must set its
# own origin, and startup fails if a loopback origin is left in place there.
# CORS is not authentication: every route still enforces its own JWT/role rules.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Completion tolerance for video playback timing (0-10 seconds).
APP_VIDEO_COMPLETION_TOLERANCE_SECONDS=2
# One-time member password setup lifetime (1-60 minutes).
APP_ACTIVATION_TOKEN_EXPIRE_MINUTES=30

# Local Docker database only. Replace the example password before use.
POSTGRES_USER=elearning
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=elearning
POSTGRES_PORT=5432

# Required by both FastAPI and Alembic. Production should inject the full URL.
# Local interpolation assumes URL-safe credentials (letters, digits, hyphens).
#
# Use the literal 127.0.0.1, not `localhost`. docker-compose publishes the
# database on 127.0.0.1 only (see its `ports:` entry), which is IPv4. On a host
# whose resolver returns ::1 before 127.0.0.1 for `localhost` - the default on
# Windows - asyncpg tries IPv6 first, nothing is listening there, and the
# refused connection takes about two seconds to give up before falling back.
#
# That cost is paid on every NEW pool connection, not once. A single request
# reuses a pooled connection and is unaffected, so the application looks fast
# until several requests arrive at the same time and the pool has to grow -
# then each of them waits ~2 s. Measured here: opening one connection takes
# 2102 ms via `localhost` and 47 ms via 127.0.0.1; five at once take 2183 ms
# against 166 ms.
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}"

# Pool limits are per application worker. Timeouts are in seconds.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=5

# Required secret: generate with python -c "import secrets; print(secrets.token_urlsafe(64))"
# Paste the generated value here or inject it through your deployment secret manager.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long POST /api/v1/auth/refresh keeps working before the member must
# log in again. Refresh tokens are not rotated, so this is the session cap.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Lifetime of lesson-scoped media playback tokens (1-240 minutes). These are
# not session credentials: see docs/storage.md. Signed with JWT_SECRET_KEY.
PLAYBACK_TOKEN_EXPIRE_MINUTES=30

# Storage provider: "memory" for local development and tests (not durable, and
# refused when APP_ENVIRONMENT=production), or "google_drive".
STORAGE_PROVIDER=memory
# Upload ceiling in bytes, enforced on bytes actually received (default 2 GiB).
STORAGE_MAX_UPLOAD_BYTES=2147483648
# Streaming block size; Google Drive rounds this down to a multiple of 256 KiB.
STORAGE_UPLOAD_CHUNK_BYTES=8388608
# Comma-separated allowlists. Add a type only after confirming it is safe to serve.
STORAGE_VIDEO_MIME_TYPES=video/mp4
STORAGE_DOCUMENT_MIME_TYPES=application/pdf

# Required only when STORAGE_PROVIDER=google_drive. See docs/storage.md for the
# one-time OAuth authorization that produces the refresh token. Never commit these.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Printed by scripts/google_drive_authorize.py, which creates this folder through
# the Drive API. Do not create it by hand: the drive.file scope cannot use a
# folder the application did not create.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_TIMEOUT_SECONDS=30
